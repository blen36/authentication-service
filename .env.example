AUTH_DB_USERNAME=auth_service
AUTH_DB_PASSWORD=
AUTH_REGISTRATION_KEY=
APP_PORT=8082
# Docker service URL. For an IDE launch use http://localhost:8081.
USER_SERVICE_URL=http://user-service:8081
JWT_PRIVATE_KEY=file:./secrets/private-key.pem
JWT_PUBLIC_KEY=file:./secrets/public-key.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_USER_ID=
AUTH_BOOTSTRAP_LOGIN=
AUTH_BOOTSTRAP_PASSWORD=
